PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/fikaai.sqlite

# Local AI (optional — fallback intent extraction works without it)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ENABLED=true

# Hosted AI (ModelScope OpenAI-compatible API) — never commit real keys
MODELSCOPE_BASE_URL=https://api-inference.modelscope.ai/v1
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=Qwen-Ambassador/Qwen3.7-Max

# Provider selection: auto | ollama | modelscope | mock
LLM_PROVIDER=auto

DEFAULT_USER_ID=demo-user
CONNECTIVITY_MODE=online
